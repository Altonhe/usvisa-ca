# Docker knobs only. Compose reads this file to substitute ${VAR} in
# docker-compose.yml -- it is NOT application configuration.
#
# Everything about accounts, targets, Telegram and dashboard auth lives in
# config.yaml. Copy this to .env if you want to change the values below.

# Host address:port the dashboard is published on.
# Keep it on 127.0.0.1 unless you have set dashboard.password in config.yaml.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8000

# Container timezone, so log timestamps match yours.
# This affects log rendering ONLY. Appointment polling schedules itself on each
# consulate's own local time (see active_hours in config.yaml), which is built
# into the app -- changing this will not shift when the bot polls.
TZ=America/Vancouver


# OpenVPN provider (started by `docker compose up`).
# Profile file name in deploy/openvpn/ to start on, e.g.
# ca2102.nordvpn.com.udp.ovpn. Empty starts on the first allowlisted one;
# "random" picks one at random.
OPENVPN_CONFIG_NAME=

# Route AIS traffic through the provider. These are the compose defaults;
# uncomment both (empty) to go direct while the provider still runs.
# OPENVPN_PROVIDER_URL=
# AIS_PROXY=
